{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["image", "controller", "service"],
  "properties": {
    "image": {
      "type": "object",
      "required": ["repository"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "pullPolicy": {
          "type": "string",
          "enum": ["Always", "IfNotPresent", "Never"]
        }
      }
    },
    "imagePullSecrets": { "type": "array" },
    "nameOverride": { "type": "string" },
    "fullnameOverride": { "type": "string" },
    "controller": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": { "type": "string", "enum": ["Deployment", "DaemonSet"] },
        "replicas": { "type": "integer", "minimum": 0 },
        "hostNetwork": { "type": "boolean" },
        "dnsPolicy": { "type": "string" },
        "nodeSelector": { "type": "object" },
        "tolerations": { "type": "array" },
        "affinity": { "type": "object" },
        "annotations": { "type": "object" },
        "podAnnotations": { "type": "object" },
        "podLabels": { "type": "object" },
        "resources": { "type": "object" },
        "podSecurityContext": { "type": "object" },
        "containerSecurityContext": { "type": "object" },
        "updateStrategy": { "type": "object" }
      }
    },
    "serviceAccount": {
      "type": "object",
      "properties": {
        "create": { "type": "boolean" },
        "name": { "type": "string" },
        "annotations": { "type": "object" }
      }
    },
    "service": {
      "type": "object",
      "required": ["port"],
      "properties": {
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "annotations": { "type": "object" }
      }
    },
    "serviceMonitor": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "namespace": { "type": "string" },
        "interval": { "type": "string" },
        "scrapeTimeout": { "type": "string" },
        "labels": { "type": "object" },
        "relabelings": { "type": "array" },
        "metricRelabelings": { "type": "array" }
      }
    },
    "config": {
      "type": "object",
      "properties": {
        "listenAddress": { "type": "string" },
        "scrapeTimeout": { "type": "string" },
        "tunnel": {
          "type": "object",
          "properties": {
            "name": { "type": "string" },
            "managementAddress": { "type": "string" },
            "certPath": { "type": "string" },
            "configPath": { "type": "string" }
          }
        },
        "tunnels": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "managementAddress"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "managementAddress": { "type": "string", "minLength": 1 },
              "certPath": { "type": "string" },
              "configPath": { "type": "string" }
            }
          }
        },
        "server": {
          "type": "object",
          "properties": {
            "name": { "type": "string" },
            "managementAddress": { "type": "string" },
            "certPath": { "type": "string" },
            "configPath": { "type": "string" }
          }
        },
        "servers": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "managementAddress"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "managementAddress": { "type": "string", "minLength": 1 },
              "certPath": { "type": "string" },
              "configPath": { "type": "string" }
            }
          }
        },
        "targetsGlob": { "type": "string" },
        "passwordSecretName": { "type": "string" },
        "passwordSecretKey": { "type": "string" }
      }
    },
    "extraArgs": { "type": "array" },
    "extraEnv": { "type": "array" },
    "extraVolumes": { "type": "array" },
    "extraVolumeMounts": { "type": "array" },
    "livenessProbe": { "type": "object" },
    "readinessProbe": { "type": "object" }
  }
}
